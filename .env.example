# Database
# For Docker Compose, use the postgres service hostname (not localhost)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/Sale1404
DB_HOST=postgres
DB_NAME=Sale1404
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# When connecting from Windows/pgAdmin to DOCKER Postgres, use port 5433:
# postgresql://postgres:postgres@localhost:5433/Sale1404
# Port 5432 on your PC may be local Windows PostgreSQL, not Docker.

# Docker database bootstrap
AUTO_IMPORT_SALE1404=true
SEED_DATABASE=false
MIN_PRODUCTS_FOR_IMPORT=100
SALE1404_SQL_PATH=Sale1404.sql

# Redis
REDIS_URL=redis://redis:6379/0
ENABLE_CACHE=true

# Latency / retrieval
EMBEDDING_DIMENSION=3072
FAISS_INDEX_PATH=indexes/faiss.index
BUILD_FAISS_ON_START=true
METADATA_CACHE_TTL_SECONDS=300

# App
ENVIRONMENT=production
ENABLE_PII_DETECTION=true

GEMINI_API_URL=
GEMINI_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
OPENAI_API_KEY=

SENTRY_DSN=
ENVIRONMENT=development
